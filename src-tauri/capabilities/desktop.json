{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop",
	"description": "Capability for the main window (desktop only)",
	"windows": ["main"],
	"platforms": ["linux", "macOS", "windows"],
	"permissions": [
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-maximize",
		"core:window:allow-unmaximize",
		"core:window:allow-is-maximized",
		"core:window:allow-close",
		"core:window:allow-hide",
		"core:window:allow-show",
		"core:app:allow-default-window-icon",
		"dialog:default",
		{
			"identifier": "http:default",
			"allow": [
				{
				  "url": "https://api.legendary.gl/v1/sdl/*"
				}
			]
		},
		{
			"identifier": "fs:allow-app-read-recursive",
			"allow": [
				{
					"path": "C:/ProgramData/Epic/EpicGamesLauncher/Data/Manifests/*"
				},
				{
					"path": "C:/ProgramData/Epic/EpicGamesLauncher/Data/Manifests"
				}
			]
		},
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "binaries/legendary",
					"sidecar": true
				}
			]
		},
  {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DATA/dozamigos-launcher"
        },
        {
          "path": "$DATA/dozamigos-launcher/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "com.epicgames.launcher://*"
        },
        {
          "url": "com.epicgames.launcher:*"
        }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart"
	]
}
