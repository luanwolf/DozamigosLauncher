# Copy to `.env` or `.env.local` and fill in your keys.
# Never commit real keys — `.env*` is gitignored except this file.

# fortnite-api.com — optional; enables higher rate limits and stats endpoints.
# Get a key: https://dash.fortnite-api.com/
VITE_FORTNITE_API_KEY=your-fortnite-api-key-here

# api-fortnite.com — optional; supplies public season dates without an Epic login.
# Get a key: https://api-fortnite.com/
VITE_API_FORTNITE_KEY=your-api-fortnite-key-here

# fnbr.co — optional; enriches Battle Pass tiers via cosmetic search.
# Request access: https://fnbr.co/discord
VITE_FNBR_API_KEY=your-fnbr-api-key-here
